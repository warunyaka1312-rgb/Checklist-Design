# คัดลอกไฟล์นี้เป็น "includes/.env" แล้วใส่ค่าจริง (ห้าม commit .env)

# ---- Application ----
# URL ที่ใช้เข้าเว็บจริง (ไม่มี "/" ปิดท้าย) — ใช้สร้างลิงก์ทั้งระบบ รวมถึง Keycloak callback
# local: http://localhost/Checklist_Design
# server: http://arena.alumetgroup.com/dds/Checklist_Design
APP_BASE_URL=http://localhost/Checklist_Design

# ---- Database (MySQL) ----
# XAMPP local ปกติ: DB_HOST=localhost, DB_PORT=3306, DB_USER=root, DB_PASS= (ว่าง)
# ตอน deploy ให้ใส่ค่าที่ cPanel/hosting สร้างฐานข้อมูลให้มา
DB_HOST=localhost
DB_PORT=3306
DB_NAME=checklist_design
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---- Customer API (SAP) — ปุ่ม "Sync จาก API" ในหน้า Admin > ลูกค้า และ cli/sync_customers.php ----
CUSTOMER_API_URL=http://almdc.alumetgroup.com/sap/api/v1/customer-all-ho/
CUSTOMER_API_KEY=
CUSTOMER_API_TIMEOUT=15

# ---- Drawing image API — ปุ่ม "ดึงจาก API" ในหน้า Checklist (รูปภาพแบบ) ----
# ระบบจะเรียก {IMAGE_FETCH_API_URL}{Tech}/ พร้อม header X-Api-Key แล้วดาวน์โหลดรูปจาก td_image_url
# ค่า KEY ใส่เฉพาะในไฟล์ .env จริงเท่านั้น (ห้ามใส่ในไฟล์ .example / ห้าม commit)
IMAGE_FETCH_API_URL=http://sandboxalmdc.alumetgroup.com:8803/alm_profile/api/drawings/
IMAGE_FETCH_API_KEY=
IMAGE_FETCH_API_TIMEOUT=10

# ---- Tech drawing spec — ปุ่ม "ดึงจากโปรแกรมพี่ตุ้ม" ในหน้าสร้าง Checklist ----
# เรียก {IMAGE_FETCH_API_URL}{Tech}/sap-spec/ พร้อม header X-Api-Key
# เติมให้อัตโนมัติ: Model (model), Material (material_1), Temper (temper_1)
# ใช้ host + key ชุดเดียวกับ Drawing image API จึงไม่ต้องตั้งค่าเพิ่ม
# ตั้ง 2 ค่านี้เฉพาะตอนที่ endpoint spec แยก host/key ออกจาก API รูปภาพ
#TECHDRAWING_SPEC_URL=
#TECHDRAWING_SPEC_KEY=
TECHDRAWING_API_TIMEOUT=15

# ประเภทแม่พิมพ์ (Solid/Hollow) กับชื่อหน้าตัด ไม่มีใน sap-spec จึงอ่านเสริมจาก
# feed ตัวนี้ (cache ไว้ 30 นาที) — ถ้าเรียกไม่ได้ก็แค่ไม่เติม 2 ช่องนั้น ไม่ error
TECHDRAWING_FEED_URL=http://almdc.alumetgroup.com/sap/api/v1/techdrawing-active/
TECHDRAWING_FEED_TIMEOUT=30

# ---- Keycloak SSO (หน้า login) ----
# เปิดใช้เมื่อกรอก KC_SERVER + KC_REALM + KC_CLIENT_ID ครบ — หน้า login จะเปลี่ยนเป็นปุ่มเข้าสู่ระบบผ่าน Keycloak
# สิทธิ์มาจาก Client roles ของ client นี้ใน Keycloak (admin / engineer / manager) — login ครั้งแรกระบบสร้างผู้ใช้ให้เอง
# และอัปเดต role/ชื่อตาม Keycloak ทุกครั้งที่ login — ไม่มี role ใดเลย = เข้าระบบไม่ได้
KC_SERVER=https://almdc.alumetgroup.com:40020
KC_REALM=AlmSap
KC_CLIENT_ID=Checklist_Design
KC_CLIENT_SECRET=
# เว้นว่าง = ใช้ {APP_BASE_URL}/callback.php — ต้องลงทะเบียน URL นี้ใน Valid redirect URIs ของ client บน Keycloak
KC_REDIRECT_URI=
# false เฉพาะกรณี server ใช้ certificate ที่เครื่องนี้ยังไม่เชื่อถือ (self-signed / internal CA)
KC_SSL_VERIFY=true
KC_TIMEOUT=10
# true = แสดงฟอร์ม username/password ภายในไว้ใต้ปุ่ม Keycloak (สำรองกรณี Keycloak ล่ม) — ปกติให้ปิด
KC_ALLOW_LOCAL_LOGIN=false
# ชื่อ client roles ใน Keycloak ที่จับคู่กับสิทธิ์ของระบบนี้ (เว้นว่าง = admin / manager / engineer)
# ถ้ามีหลาย role ใช้สิทธิ์สูงสุด: admin > manager > engineer
KC_ROLE_ADMIN=
KC_ROLE_MANAGER=
KC_ROLE_ENGINEER=
# client ที่เก็บ roles ข้างบน (เว้นว่าง = KC_CLIENT_ID)
KC_ROLE_CLIENT=
